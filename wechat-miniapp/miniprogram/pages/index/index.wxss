.page { padding: 28rpx 30rpx 50rpx; min-height: 100vh; box-sizing: border-box; }
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 8rpx 0 34rpx; }
.brand { display: flex; align-items: center; gap: 18rpx; font-size: 34rpx; font-weight: 900; letter-spacing: -1rpx; }
.logo { width: 76rpx; height: 76rpx; border-radius: 50%; background: #242223; color: white; display: flex; align-items: center; justify-content: center; font-size: 33rpx; transform: rotate(-4deg); }
.logo text { color: #f5a2c4; font-size: 22rpx; transform: translateY(-14rpx); }
.top-actions { display: flex; align-items: center; gap: 14rpx; }
.language { border: 2rpx solid #ded5d3; border-radius: 999rpx; padding: 15rpx 20rpx; font-size: 24rpx; background: rgba(255,255,255,.65); }
.help { width: 66rpx; height: 66rpx; line-height: 62rpx; padding: 0; border: 2rpx solid #ded5d3; background: transparent; font-size: 31rpx; }
.help-card { margin-bottom: 28rpx; background: #fff; border: 3rpx solid #242223; border-radius: 28rpx; padding: 28rpx; line-height: 1.65; font-size: 26rpx; box-shadow: 8rpx 8rpx 0 #e7def2; }
.help-title { display: flex; justify-content: space-between; font-weight: 900; font-size: 30rpx; margin-bottom: 12rpx; }
.help-title button { padding: 0; width: 44rpx; background: transparent; line-height: 38rpx; }
.hero { padding: 28rpx 2rpx 42rpx; }
.eyebrow { display: block; font-size: 23rpx; font-weight: 800; letter-spacing: 2rpx; margin-bottom: 22rpx; }
.title { font-size: 116rpx; line-height: 1; font-weight: 950; letter-spacing: -9rpx; }
.title text { color: #7250e8; position: relative; }
.title text::after { content: ''; position: absolute; left: 0; right: -8rpx; bottom: 5rpx; height: 17rpx; background: #f6a5c6; z-index: -1; transform: rotate(-2deg); }
.subtitle { color: #665d61; font-size: 30rpx; line-height: 1.7; margin: 28rpx 0; }
.sample-card { background: #f7a7c8; border: 4rpx solid #252324; border-radius: 38rpx; padding: 34rpx; box-shadow: 12rpx 12rpx 0 #252324; display: flex; flex-direction: column; gap: 20rpx; transform: rotate(-1deg); }
.sample-tag { font-size: 20rpx; font-weight: 900; letter-spacing: 3rpx; }
.sample-prefix { font-size: 26rpx; }
.sample-main { font-size: 37rpx; line-height: 1.4; font-weight: 900; }
.card, .game-card { background: rgba(255,255,255,.88); border: 3rpx solid #252324; border-radius: 36rpx; padding: 34rpx; box-shadow: 10rpx 10rpx 0 #e7def2; }
.tabs { display: flex; padding: 7rpx; background: #eee8e7; border-radius: 999rpx; margin-bottom: 30rpx; }
.tabs button { width: 50%; background: transparent; font-size: 27rpx; padding: 17rpx 8rpx; }
.tabs .active { background: #fff; box-shadow: 0 3rpx 12rpx rgba(0,0,0,.09); }
.label { display: block; font-weight: 800; font-size: 25rpx; margin: 0 0 12rpx; }
.spaced { margin-top: 28rpx; }
.input, .textarea { width: 100%; box-sizing: border-box; background: #fff; border: 2rpx solid #d8cecc; border-radius: 22rpx; padding: 24rpx; font-size: 28rpx; }
.code-input { text-transform: uppercase; letter-spacing: 11rpx; font-weight: 900; }
.modes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; }
.modes button { padding: 18rpx 8rpx; background: #fff; border: 2rpx solid #ddd1d0; font-size: 23rpx; }
.modes button text { display: block; font-size: 32rpx; }
.modes .selected, .rounds .selected { background: #d9f678; border-color: #252324; }
.rounds { display: flex; justify-content: space-between; align-items: center; margin: 28rpx 0; font-size: 25rpx; font-weight: 800; }
.rounds view { display: flex; gap: 10rpx; }
.rounds button { width: 78rpx; padding: 12rpx 0; background: #fff; border: 2rpx solid #ddd1d0; font-size: 23rpx; }
.primary { width: 100%; background: #242223; color: #fff; padding: 24rpx; font-size: 28rpx; margin-top: 26rpx; }
.primary[disabled] { opacity: .35; }
.entry-foot { display: flex; justify-content: space-between; color: #776d70; font-size: 20rpx; margin-top: 28rpx; }
.room-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 26rpx; }
.room-head view { display: flex; flex-direction: column; font-size: 20rpx; color: #786e71; }
.room-code { color: #242223; font-size: 40rpx; font-weight: 950; letter-spacing: 6rpx; }
.share { background: #7250e8; color: white; padding: 17rpx 25rpx; font-size: 24rpx; }
.game-card { margin-bottom: 28rpx; }
.lobby, .center, .result { text-align: center; }
.big-mark { color: #7250e8; font-size: 100rpx; }
.game-title { display: block; font-size: 50rpx; line-height: 1.25; font-weight: 950; margin: 18rpx 0 30rpx; }
.code-box { margin: 25rpx 0; background: #f5a3c6; border-radius: 25rpx; padding: 22rpx; }
.code-box text { display: block; font-size: 20rpx; }
.code-box strong { display: block; font-size: 48rpx; letter-spacing: 8rpx; }
.waiting { display: block; color: #71676a; padding: 30rpx 0; font-size: 27rpx; }
.phase-line { display: flex; justify-content: space-between; align-items: center; font-size: 21rpx; font-weight: 800; letter-spacing: 1rpx; margin: 14rpx 4rpx 18rpx; }
.blind-card { width: 280rpx; height: 380rpx; border-radius: 32rpx; margin: 20rpx auto 35rpx; background: #242223; color: #f5a3c6; font-size: 180rpx; line-height: 360rpx; font-weight: 950; transform: rotate(-4deg); box-shadow: 14rpx 14rpx 0 #7250e8; }
.secret { display: flex; flex-direction: column; align-items: center; background: #d9f678; border: 3rpx solid #252324; border-radius: 28rpx; padding: 25rpx; margin-bottom: 30rpx; }
.secret strong { font-size: 110rpx; line-height: 1.1; }
.secret small { color: #5c6350; }
.section-head { display: flex; justify-content: space-between; align-items: center; font-size: 28rpx; font-weight: 900; margin-bottom: 18rpx; }
.section-head button { font-size: 22rpx; background: transparent; color: #7250e8; padding: 8rpx; }
.suggestions { display: grid; gap: 13rpx; }
.suggestions button { border: 2rpx solid #dacfd0; border-radius: 22rpx; background: #fff; text-align: left; padding: 20rpx; font-size: 25rpx; line-height: 1.45; font-weight: 600; }
.textarea { min-height: 190rpx; }
.speech { margin-top: 16rpx; width: 100%; border: 2rpx solid #7250e8; color: #7250e8; background: #f6f2ff; padding: 20rpx; font-size: 25rpx; }
.speech.recording { background: #7250e8; color: white; }
.speech-note { display: block; color: #82787b; font-size: 20rpx; line-height: 1.5; margin-top: 12rpx; }
.waiting-stage { min-height: 390rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #7250e8; font-size: 90rpx; }
.waiting-stage text { color: #242223; font-size: 31rpx; font-weight: 900; margin-top: 15rpx; }
.waiting-stage small { color: #6d6467; font-size: 25rpx; margin-top: 24rpx; line-height: 1.5; }
.clue { display: block; background: #f5a3c6; border: 3rpx solid #252324; border-radius: 28rpx; padding: 30rpx; font-size: 35rpx; line-height: 1.45; font-weight: 900; }
.clue.small { font-size: 25rpx; text-align: left; margin-top: 28rpx; }
.score-title { font-size: 39rpx; margin-top: 36rpx; }
.score-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14rpx; }
.score-grid button { background: #fff; border: 2rpx solid #252324; padding: 20rpx 0; font-size: 30rpx; }
.score-grid .picked { background: #d9f678; box-shadow: 5rpx 5rpx 0 #252324; transform: translate(-2rpx,-2rpx); }
.result-title { display: block; font-size: 64rpx; font-weight: 950; margin: 20rpx 0; }
.reveal { display: flex; align-items: center; justify-content: center; gap: 32rpx; }
.reveal view { display: flex; flex-direction: column; }
.reveal strong { font-size: 90rpx; }
.podium { display: grid; gap: 12rpx; margin: 25rpx 0; }
.podium view { display: flex; justify-content: space-between; padding: 18rpx 25rpx; background: #f5a3c6; border-radius: 18rpx; font-size: 27rpx; font-weight: 800; }
.members { margin-top: 28rpx; }
.member { display: flex; align-items: center; gap: 18rpx; padding: 17rpx 0; border-bottom: 1rpx solid #ebe2e1; }
.avatar { width: 68rpx; height: 68rpx; line-height: 68rpx; text-align: center; border-radius: 50%; background: #d9f678; font-weight: 900; }
.member > view:nth-child(2) { flex: 1; display: flex; flex-direction: column; font-size: 27rpx; font-weight: 800; }
.member small { color: #83797c; font-size: 21rpx; font-weight: 500; }
.member > strong { color: #7250e8; font-size: 31rpx; }
.room-actions { display: flex; gap: 12rpx; margin-top: 25rpx; }
.room-actions button { flex: 1; border: 2rpx solid #d9cecd; background: #fff; padding: 17rpx; font-size: 23rpx; }
.connection { display: block; text-align: center; color: #6e9c12; font-size: 18rpx; letter-spacing: 2rpx; margin-top: 22rpx; }
@media (min-width: 700px) { .page { max-width: 750px; margin: auto; } }
